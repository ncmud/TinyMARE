#!/bin/sh
# Start either build from the game's runtime directory.
set -eu
if [ "$#" -lt 1 ]; then
  echo "Usage: $0 executable [netmare arguments...]" >&2
  exit 1
fi
case "$1" in
  /*) executable=$1 ;;
  *) executable="$PWD/$1" ;;
esac
shift
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir/run"
mkdir -p db logs
exec "$executable" "$@"
